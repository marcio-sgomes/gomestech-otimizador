<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Otimizador" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
    </style>

    <!-- Modelo de cartão usado em todas as telas -->
    <style name="Cartao" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="TituloCartao">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
