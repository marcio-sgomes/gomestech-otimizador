<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Nota de saúde do celular -->
        <com.google.android.material.card.MaterialCardView style="@style/Cartao">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="56sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtNotaDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtAparelho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Armazenamento -->
        <com.google.android.material.card.MaterialCardView style="@style/Cartao">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloCartao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Armazenamento" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barArmazenamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100" />

                <TextView
                    android:id="@+id/txtArmazenamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Memória RAM -->
        <com.google.android.material.card.MaterialCardView style="@style/Cartao">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloCartao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Memória (RAM)" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barRam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100" />

                <TextView
                    android:id="@+id/txtRam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bateria (resumo) -->
        <com.google.android.material.card.MaterialCardView style="@style/Cartao">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloCartao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bateria" />

                <TextView
                    android:id="@+id/txtBateriaResumo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dicas automáticas -->
        <com.google.android.material.card.MaterialCardView style="@style/Cartao">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloCartao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O que fazer agora" />

                <TextView
                    android:id="@+id/txtDicas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManutencaoMarca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Checklist semanal -->
        <com.google.android.material.card.MaterialCardView style="@style/Cartao">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloCartao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checklist da semana" />

                <LinearLayout
                    android:id="@+id/listaChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swLembrete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Me lembrar toda semana" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
