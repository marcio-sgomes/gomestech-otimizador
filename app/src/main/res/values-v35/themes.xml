<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+: com targetSdk 35 o sistema força "tela de ponta a ponta" e a barra
         superior ficaria por baixo da barra de status. Mantém o visual igual às outras versões. -->
    <style name="Theme.Otimizador" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
